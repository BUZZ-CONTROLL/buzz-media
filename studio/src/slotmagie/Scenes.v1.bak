const SYMBOLS = ["7", "BAR", "★", "♦", "♣", "7", "BAR", "★"];
const Reel: React.FC<{ stop: number; final: number }> = ({ stop, final }) => {
  const f = useCurrentFrame();
  const cell = 200;
  const total = 16 + final;
  const t = interpolate(f, [6, stop], [0, 1], {
    extrapolateLeft: "clamp",
    extrapolateRight: "clamp",
    easing: (x) => 1 - Math.pow(1 - x, 3),
  });
  const pos = t * total;
  return (
    <div
      style={{
        width: 250,
        height: cell * 1.6,
        overflow: "hidden",
        borderRadius: 16,
        background: "linear-gradient(180deg, #d9d9d9 0%, #ffffff 30%, #ffffff 70%, #bdbdbd 100%)",
        position: "relative",
      }}
    >
      <div
        style={{
          translate: `0px ${-pos * cell + cell * 0.3}px`,
          filter: `blur(${(1 - t) * 10}px)`,
        }}
      >
        {new Array(total + 3).fill(0).map((_, i) => {
          const s = SYMBOLS[i % SYMBOLS.length];
          return (
            <div
              key={i}
              style={{
                height: cell,
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                fontFamily: FONT,
                fontWeight: 900,
                fontStyle: "italic",
                fontSize: s === "BAR" ? 84 : 140,
                color: s === "7" ? C.red : s === "★" ? C.gold3 : "#222",
              }}
            >
              {s}
            </div>
          );
        })}
      </div>
    </div>
  );
};

